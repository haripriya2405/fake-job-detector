# Application Environment & Logging
APPLICATION_ENV=production
ENVIRONMENT=production
DEBUG=false
APP_NAME="SentinelJob AI Backend"
API_V1_STR="/api/v1"
PORT=8000
HOST=0.0.0.0

# Security & Secret Keys
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_64_CHAR_HEX_KEY_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Production Database Configuration
POSTGRES_DB=fake_job_detector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_POSTGRES_PASSWORD
DATABASE_URL=postgresql://postgres:CHANGE_THIS_SECURE_POSTGRES_PASSWORD@postgres:5432/fake_job_detector

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://app.sentineljob.ai
FRONTEND_URL=http://localhost:3000

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_ANALYSIS_PER_MINUTE=20

# Multi-Modal Upload Limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.webp
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/png,image/jpeg,image/webp

# Timeouts & Safety Guardrails
OCR_TIMEOUT_SECONDS=10
URL_FETCH_TIMEOUT_SECONDS=8
